.DS_Store

# Written by the `mip?` test on every run
/examples/mip_tactic_tests-*.vipr

# Local-only files
/AGENT_HANDOFF.md
/paper/
/slides/

# Regenerated by examples/audit/scip-final-row/freq/freq.py; bin/ holds viprchk and
# viprcomp built from scipopt/vipr
/examples/audit/scip-final-row/freq/bin/
/examples/audit/scip-final-row/freq/models/
/examples/audit/scip-final-row/freq/work-*/
/examples/audit/scip-final-row/freq/run-*.log

# Large benchmark certificates; fetch with benchmarks/download_new.py
/benchmarks/new/*/*.vipr.gz
/benchmarks/new/*/*.vipr.gz.part
/benchmarks/new/*/*.vipr.gz.gzpart

# Local build of the reference C++ checker (scipopt/vipr @ 99eec19); see benchmarks/new/README.md
/viprcheck/
# Temporary rusage files written by benchmarks/run_new.py while a run is in progress
/benchmarks/results/*_logs/*.time
